# /etc/everrec/server.env
EVERREC_DATABASE_URL=postgresql+psycopg://everrec@/everrec
EVERREC_LOST_AFTER=120
EVERREC_SWEEP_SECONDS=15
# 录像根目录（正式部署 /srv/everrec/recordings）；补传并发名额
EVERREC_RECORDINGS_DIR=/srv/everrec/recordings
EVERREC_BACKFILL_LIMIT=5
# 事件推送（通用 JSON + HMAC 签名）；不配 URL 则不推送
EVERREC_WEBHOOK_URL=https://example.com/hooks/everrec
EVERREC_WEBHOOK_SECRET=请改成随机字符串
# 可选自定义请求头（JSON，例如 {"Authorization": "Bearer xxx"}）
# EVERREC_WEBHOOK_HEADERS={}
# 正式部署由 Nginx 提供管理网站静态文件；不经 Nginx 试用时可打开下一行
# EVERREC_WEB_DIST=/opt/everrec/web/dist
